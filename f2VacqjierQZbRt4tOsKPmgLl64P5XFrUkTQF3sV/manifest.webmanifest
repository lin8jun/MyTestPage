{
  "description": "Slot Portrait Hall is a fast portrait-first web app with installable full-screen gameplay.",
  "id": "../index.html{query}",
  "name": "Slot Portrait Hall",
  "short_name": "Slot Portrait Hall",
  "start_url": "../index.html{query}",
  "scope": "../",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#000a1b",
  "theme_color": "#000a1b",
  "categories": [
    "games",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "../manifest.webmanifest",
      "id": "../index.html{query}"
    }
  ],
  "icons": [
    {
      "src": "../icon_192.webp",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "../icon_512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "../install_shot_mobile_1.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "name": "Mobile install preview 1",
      "label": "Mobile install preview 1"
    },
    {
      "src": "../install_shot_mobile_2.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "name": "Mobile install preview 2",
      "label": "Mobile install preview 2"
    },
    {
      "src": "../install_shot_mobile_3.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "name": "Mobile install preview 3",
      "label": "Mobile install preview 3"
    },
    {
      "src": "../install_shot_mobile_4.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "name": "Mobile install preview 4",
      "label": "Mobile install preview 4"
    },
    {
      "src": "../install_shot_mobile_5.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "name": "Mobile install preview 5",
      "label": "Mobile install preview 5"
    },
    {
      "src": "../install_shot_desktop.webp",
      "sizes": "1600x900",
      "type": "image/webp",
      "form_factor": "wide",
      "name": "Desktop install preview",
      "label": "Desktop install preview"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+vegasfox",
      "url": "../index.html?url=%s"
    }
  ]
}